# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
template1 = GetTemplate(TemplateName="TurboFluidFlow")
system1 = template1.CreateSystem()
template2 = GetTemplate(TemplateName="BladeGen")
system2 = template2.CreateSystem(
    Position="Right",
    RelativeTo=system1)
template3 = GetTemplate(TemplateName="BladeBuilderSystemTemplate")
system3 = template3.CreateSystem(
    Position="Right",
    RelativeTo=system2)
Save(Overwrite=True)
template4 = GetTemplate(
    TemplateName="Fluid Flow",
    Solver="CFX")
system4 = template4.CreateSystem(
    Position="Below",
    RelativeTo=system1)
setup1 = system1.GetContainer(ComponentName="Setup")
setup1.Edit()
setup1.Exit()
setup1.Edit()
setup1.Exit()
setup2 = system4.GetContainer(ComponentName="Setup")
setup2.Edit()
setup2.Exit()
setup1.Edit()
setup1.SendCommand(Command="""VIEW:View 1
  Light Angle = 50, 110
END

